{
  "name": "crinklecutsnv.github.io",
  "version": "0.1.0",
  "description": "CrinkleCutSnV's playground: little web apps and games made for fun.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:physics": "esbuild scripts/sim.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/sim.mjs --format=esm && node node_modules/.cache/sim.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:features": "node scripts/feature-shots.mjs",
    "check:disc": "esbuild scripts/disc-sim.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/disc-sim.mjs --format=esm && node node_modules/.cache/disc-sim.mjs",
    "test:disc": "node scripts/disc-tests.mjs",
    "test:scores": "node scripts/scores-tests.mjs",
    "test:swoop": "node scripts/swoop-tests.mjs",
    "check:split": "esbuild scripts/split-sim.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/split-sim.mjs --format=esm && node node_modules/.cache/split-sim.mjs",
    "test:split": "npm run check:split && node scripts/split-tests.mjs"
  },
  "dependencies": {
    "astro": "^5.18.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "private": true,
  "type": "module"
}
