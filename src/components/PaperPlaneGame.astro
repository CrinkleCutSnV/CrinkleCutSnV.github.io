---
// Paper aeroplane throwing game. All logic lives in src/scripts/paper-plane/.
---
<div class="pp" data-paper-plane>
  <canvas aria-label="Paper aeroplane game. Drag the plane to the right and let go to throw it."></canvas>
  <div class="hud">
    <div class="pill" data-distance>0.0 m</div>
    <div class="pill pill--best" data-best>Best: –</div>
  </div>
  <div class="hint" data-hint>
    <strong>Drag the plane to the right and let go!</strong>
    <span>Faster flick = faster throw. Aim slightly upwards for a long glide, but mind the ceiling.</span>
  </div>
  <div class="aim is-hidden" data-aim></div>
  <div class="end is-hidden" data-end role="dialog" aria-live="polite" aria-label="Flight result">
    <div class="end-card">
      <p class="end-label">Your plane flew</p>
      <p class="end-distance" data-end-distance>0.0 m</p>
      <p class="end-remark" data-end-remark></p>
      <p><span class="end-best" data-end-best></span></p>
      <button type="button" data-again>Throw again</button>
    </div>
  </div>
</div>

<script>
  import { initPaperPlane } from '../scripts/paper-plane/game';
  document.querySelectorAll<HTMLElement>('[data-paper-plane]').forEach((el) => initPaperPlane(el));
</script>

<style>
  .pp {
    position: relative;
    width: 100%;
    height: clamp(320px, min(78vh, 62vw), 820px);
    border: 3px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--ink);
    background: #f6e7c8;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  .pp[data-phase='aiming'] canvas { cursor: grabbing; }
  .pp[data-phase='flying'] canvas, .pp[data-phase='landed'] canvas { cursor: default; }
  .hud { position: absolute; inset: .75rem .75rem auto; display: flex; justify-content: space-between; pointer-events: none; }
  .pill { background: #fff; border: 2px solid var(--ink); border-radius: 999px; padding: .3rem .85rem; font-weight: 800; font-size: clamp(1rem, 2.4vw, 1.4rem); font-variant-numeric: tabular-nums; box-shadow: 3px 3px 0 var(--ink); }
  .pill--best { background: var(--sun); font-size: clamp(.85rem, 1.8vw, 1.05rem); align-self: center; }
  .hint { position: absolute; left: 50%; top: 22%; transform: translateX(-30%); max-width: min(420px, 70%); background: rgba(255,255,255,.92); border: 2px solid var(--ink); border-radius: 14px; padding: .7rem .9rem; pointer-events: none; display: grid; gap: .25rem; font-size: .92rem; line-height: 1.35; animation: bob 2.2s ease-in-out infinite; }
  .hint strong { font-size: 1.05rem; }
  @keyframes bob { 50% { transform: translateX(-30%) translateY(-6px); } }
  .aim { position: absolute; transform: translate(-50%, -100%); background: rgba(43,45,66,.82); color: #fff; font-weight: 700; font-size: .8rem; padding: .15rem .5rem; border-radius: 999px; pointer-events: none; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .end { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(43,45,66,.25); }
  .end-card { background: #fff; border: 3px solid var(--ink); border-radius: var(--radius); box-shadow: 6px 6px 0 var(--ink); padding: 1.2rem 1.6rem 1.4rem; text-align: center; max-width: min(380px, 88%); animation: pop .25s ease-out; }
  @keyframes pop { from { transform: scale(.85) rotate(-3deg); opacity: 0; } }
  .end-card p { margin: 0; }
  .end-label { font-weight: 700; opacity: .7; }
  .end-distance { font-size: clamp(2.4rem, 7vw, 3.6rem); font-weight: 900; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .end-remark { margin: .35rem 0 .6rem !important; }
  .end-best { display: inline-block; font-weight: 800; margin-bottom: .9rem; padding: .1rem .7rem; border: 2px solid transparent; }
  .end-best.is-new { background: var(--sun); border: 2px solid var(--ink); border-radius: 999px; padding: .1rem .7rem; transform: rotate(-3deg); }
  .end button { font: inherit; font-weight: 800; font-size: 1.1rem; background: var(--accent); color: #fff; border: 3px solid var(--ink); border-radius: 999px; padding: .55rem 1.4rem; box-shadow: 3px 3px 0 var(--ink); cursor: pointer; }
  .end button:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink); }
  .end button:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
  @media (max-width: 640px) {
    .hint { top: 3.4rem; left: 50%; transform: translateX(-50%); max-width: 72%; text-align: center; font-size: .8rem; padding: .45rem .6rem; animation: none; }
    .hint strong { font-size: .88rem; }
    .hint span { display: none; }
    .end-card { padding: .8rem 1rem 1rem; }
    .end-remark { font-size: .82rem; margin: .2rem 0 .35rem !important; }
    .end-label { font-size: .8rem; }
    .end-distance { font-size: 2rem; }
    .end-best { margin-bottom: .5rem; font-size: .85rem; }
    .end button { font-size: .95rem; padding: .4rem 1.1rem; }
  }
  .is-hidden { display: none !important; }
</style>
