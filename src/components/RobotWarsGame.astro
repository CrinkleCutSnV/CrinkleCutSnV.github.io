---
// Robot Rumble. All logic lives in src/scripts/robot-wars/.
import { PART_IDS, PARTS, PART_LABEL, DRIVES, WEAPONS, BODIES, ZONES, type PartKind } from '../scripts/robot-wars/sim';
const kinds = Object.keys(PART_IDS) as PartKind[];
const info = (kind: PartKind, id: string) => (PARTS[kind] as Record<string, { name: string; blurb: string }>)[id];
const hint = (kind: PartKind, id: string): string => {
  if (kind === 'drive') { const d = DRIVES[id as keyof typeof DRIVES]; return `Fast on ${ZONES[d.fast].name.toLowerCase()} · slow on ${ZONES[d.slow].name.toLowerCase()}`; }
  if (kind === 'weapon') { const w = WEAPONS[id as keyof typeof WEAPONS]; return `Strong vs ${BODIES[w.strong].name} · weak vs ${BODIES[w.weak].name}`; }
  if (kind === 'body') {
    const fears = Object.values(WEAPONS).find((w) => w.strong === id)!, shrugs = Object.values(WEAPONS).find((w) => w.weak === id)!;
    return `${BODIES[id as keyof typeof BODIES].hp} HP · fears ${fears.name.toLowerCase()} · shrugs off ${shrugs.name.toLowerCase()}`;
  }
  return '';
};
---
<div class="rr" data-robot-wars data-phase="build">
  <!-- the workshop -->
  <section class="builder" data-builder aria-label="Build your robot">
    <div class="preview-card">
      <canvas class="preview" data-preview aria-hidden="true"></canvas>
      <div class="name-row">
        <label class="name-label" for="rr-name">Name</label>
        <input id="rr-name" class="name" data-name maxlength="22" autocomplete="off" spellcheck="false" />
        <button type="button" class="icon-btn" data-rename aria-label="Pick a random name" title="Random name">🎲</button>
      </div>
      <p class="summary" data-summary></p>
      <div class="fight-row">
        <button type="button" class="btn btn--big" data-fight>Fight! 🔧</button>
        <button type="button" class="btn btn--ghost btn--small" data-random title="Random parts">Surprise me 🎲</button>
      </div>
      <p class="best-line" data-best-line>Best streak: –</p>
    </div>
    <div class="parts">
      {kinds.map((kind) => (
        <fieldset class="part" data-kind={kind}>
          <legend>{PART_LABEL[kind]}</legend>
          <div class="opts" role="radiogroup" aria-label={PART_LABEL[kind]}>
            {PART_IDS[kind].map((id) => {
              const p = info(kind, id);
              return (
                <button type="button" class="opt" role="radio" aria-checked="false" data-part={kind} data-id={id} title={p.blurb} data-blurb={p.blurb} data-hint={hint(kind, id)}>
                  <canvas class="opt-icon" data-icon aria-hidden="true"></canvas>
                  <span class="opt-name">{p.name}</span>
                </button>
              );
            })}
          </div>
          <p class="opt-hint" data-hint-for={kind}></p>
        </fieldset>
      ))}
    </div>
  </section>

  <!-- the arena -->
  <section class="battle is-hidden" data-battle aria-label="The arena">
    <div class="hud">
      <div class="side side--0" data-side="0">
        <div class="side-top"><strong class="side-name" data-hud-name></strong><span class="side-dealt" data-hud-dealt>0</span></div>
        <div class="bar" role="progressbar" aria-label="Your robot’s health" aria-valuemin="0" aria-valuemax="100"><span data-hud-hp></span></div>
      </div>
      <div class="mid">
        <span class="timer" data-timer>60</span>
        <div class="speeds" role="group" aria-label="Battle speed">
          <button type="button" class="spd is-on" data-speed="1" aria-pressed="true">1×</button>
          <button type="button" class="spd" data-speed="2" aria-pressed="false">2×</button>
        </div>
      </div>
      <div class="side side--1" data-side="1">
        <div class="side-top"><span class="side-dealt" data-hud-dealt>0</span><strong class="side-name" data-hud-name></strong></div>
        <div class="bar" role="progressbar" aria-label="Opponent’s health" aria-valuemin="0" aria-valuemax="100"><span data-hud-hp></span></div>
      </div>
    </div>
    <div class="stage-wrap">
      <div class="stage">
        <canvas class="arena" data-arena aria-label="The arena, seen from above"></canvas>
        <div class="count is-hidden" data-count aria-live="assertive"></div>

        <div class="overlay is-hidden" data-intro role="dialog" aria-live="polite" aria-label="Next challenger">
          <div class="card intro-card">
            <p class="kicker" data-intro-kicker>Fight 1</p>
            <div class="vs">
              <div class="vs-bot"><canvas data-intro-bot="0" aria-hidden="true"></canvas><strong data-intro-name="0"></strong></div>
              <span class="vs-v">VS</span>
              <div class="vs-bot"><canvas data-intro-bot="1" aria-hidden="true"></canvas><strong data-intro-name="1"></strong></div>
            </div>
            <ul class="intro-parts" data-intro-parts></ul>
            <div class="intro-map"><canvas data-intro-map aria-hidden="true"></canvas><ul class="intro-notes" data-intro-notes></ul></div>
            <button type="button" class="btn btn--big" data-go>Activate! ⚡</button>
          </div>
        </div>

        <div class="overlay is-hidden" data-end role="dialog" aria-live="polite" aria-label="Result">
          <div class="card end-card">
            <p class="end-title" data-end-title></p>
            <p class="end-how" data-end-how></p>
            <p class="end-score" data-end-score></p>
            <p class="end-streak" data-end-streak></p>
            <div data-end-medal></div>
            <div class="end-buttons" data-end-buttons></div>
          </div>
        </div>
      </div>
      <div class="commentary">
        <p class="comm-h">🎙️ Commentary</p>
        <ol class="log" data-log aria-live="polite"></ol>
      </div>
    </div>
  </section>
</div>

<script>
  import { initRobotWars } from '../scripts/robot-wars/game';
  document.querySelectorAll<HTMLElement>('[data-robot-wars]').forEach((el) => initRobotWars(el));
</script>

<style>
  .rr { --team0: #48cae4; --team1: #ff7a59; color: var(--ink); }
  .btn { font: inherit; font-weight: 800; font-size: 1rem; background: var(--accent); color: #fff; border: 3px solid var(--ink); border-radius: 999px; padding: .5rem 1.2rem; box-shadow: 3px 3px 0 var(--ink); cursor: pointer; touch-action: manipulation; }
  .btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink); }
  .btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
  .btn--ghost { background: #fff; color: var(--ink); }
  .btn--big { font-size: 1.2rem; padding: .6rem 1.5rem; min-height: 48px; }
  .btn--small { font-size: .9rem; padding: .35rem .9rem; }
  .is-hidden { display: none !important; }

  /* ---- the workshop ---- */
  .builder { display: grid; grid-template-columns: minmax(260px, 340px) minmax(0, 1fr); gap: 1.2rem; align-items: start; }
  .preview-card { position: sticky; top: 1rem; background: #fff; border: 3px solid var(--ink); border-radius: var(--radius); box-shadow: 6px 6px 0 var(--ink); padding: .9rem; display: grid; gap: .6rem; }
  .builder > *, .preview-card > *, .stage-wrap > * { min-width: 0; }
  .preview { width: 100%; max-width: 100%; min-width: 0; aspect-ratio: 1; border-radius: 12px; border: 2px solid var(--ink); background: #a9b4c2; }
  .name-row { display: flex; align-items: center; gap: .4rem; }
  .name-label { font-weight: 800; font-size: .9rem; }
  .name { flex: 1; min-width: 0; font: inherit; font-weight: 800; font-size: 1.05rem; border: 2px solid var(--ink); border-radius: 10px; padding: .35rem .55rem; background: var(--paper); color: var(--ink); }
  .icon-btn { font-size: 1.15rem; line-height: 1; border: 2px solid var(--ink); border-radius: 10px; background: #fff; padding: .35rem .45rem; cursor: pointer; box-shadow: 2px 2px 0 var(--ink); min-width: 40px; min-height: 40px; }
  .summary { margin: 0; font-size: .88rem; line-height: 1.4; }
  .summary :global(b) { font-weight: 800; }
  .fight-row { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
  .fight-row [data-fight] { flex: 1; }
  .best-line { margin: 0; font-weight: 800; font-size: .9rem; }
  .parts { display: grid; gap: .8rem; }
  .part { border: 3px solid var(--ink); border-radius: var(--radius); background: #fff; margin: 0; padding: .5rem .8rem .7rem; box-shadow: 4px 4px 0 var(--ink); min-width: 0; }
  .part legend { font-weight: 900; text-transform: uppercase; letter-spacing: .1em; font-size: .8rem; background: var(--sun); border: 2px solid var(--ink); border-radius: 999px; padding: .1rem .7rem; }
  .opts { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; }
  .opt { font: inherit; color: var(--ink); display: grid; justify-items: center; gap: .15rem; padding: .35rem .25rem .45rem; border: 2px solid var(--ink); border-radius: 14px; background: var(--paper); cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; transition: transform .1s; }
  .opt:hover { transform: translateY(-2px); }
  .opt[aria-checked='true'] { background: #d8f4fb; box-shadow: 3px 3px 0 var(--ink); outline: 3px solid var(--team0); outline-offset: -5px; }
  .opt-icon { width: 64px; height: 64px; max-width: 100%; }
  .opt-name { font-weight: 800; font-size: .86rem; line-height: 1.15; text-align: center; }
  .opt-hint { margin: .45rem 0 0; font-size: .86rem; line-height: 1.35; min-height: 2.4em; }
  .opt-hint :global(b) { display: block; font-weight: 800; color: #c2410c; }

  /* ---- the arena ---- */
  .hud { display: grid; grid-template-columns: 1fr auto 1fr; gap: .6rem; align-items: center; margin-bottom: .6rem; }
  .side { background: #fff; border: 3px solid var(--ink); border-radius: 14px; padding: .35rem .6rem .45rem; box-shadow: 3px 3px 0 var(--ink); min-width: 0; }
  .side-top { display: flex; justify-content: space-between; gap: .4rem; align-items: baseline; }
  .side-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .95rem; }
  .side--0 .side-name::before { content: ''; display: inline-block; width: .7em; height: .7em; border-radius: 50%; background: var(--team0); border: 2px solid var(--ink); margin-right: .3em; vertical-align: -.05em; }
  .side--1 .side-name::after { content: ''; display: inline-block; width: .7em; height: .7em; border-radius: 50%; background: var(--team1); border: 2px solid var(--ink); margin-left: .3em; vertical-align: -.05em; }
  .side--1 .side-top { flex-direction: row; }
  .side--1 { text-align: right; }
  .side-dealt { font-weight: 800; font-size: .8rem; opacity: .8; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .side-dealt::before { content: '💥 '; }
  .bar { height: 14px; border: 2px solid var(--ink); border-radius: 999px; background: #eee; overflow: hidden; margin-top: .25rem; }
  .bar span { display: block; height: 100%; width: 100%; background: #3ccf7a; transition: width .2s, background-color .2s; }
  .side--1 .bar span { margin-left: auto; }
  .bar span[data-low='mid'] { background: var(--sun); }
  .bar span[data-low='low'] { background: #e5483b; }
  .mid { display: grid; justify-items: center; gap: .25rem; }
  .timer { font-weight: 900; font-size: 1.5rem; font-variant-numeric: tabular-nums; background: var(--ink); color: #fff; border-radius: 10px; padding: 0 .55rem; min-width: 2.6ch; text-align: center; }
  .timer[data-hurry] { background: #e5483b; }
  .speeds { display: flex; border: 2px solid var(--ink); border-radius: 999px; overflow: hidden; background: #fff; }
  .spd { font: inherit; font-weight: 800; font-size: .85rem; border: 0; background: none; padding: .2rem .6rem; cursor: pointer; min-height: 32px; color: var(--ink); touch-action: manipulation; }
  .spd + .spd { border-left: 2px solid var(--ink); }
  .spd.is-on { background: var(--sun); }
  .stage-wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 300px); gap: 1rem; align-items: start; }
  .stage { position: relative; width: 100%; max-width: 640px; aspect-ratio: 1; border: 3px solid var(--ink); border-radius: var(--radius); overflow: hidden; box-shadow: 6px 6px 0 var(--ink); background: #a9b4c2; justify-self: center; }
  .arena { display: block; width: 100%; height: 100%; }
  .count { position: absolute; inset: 0; display: grid; place-items: center; font-size: clamp(3rem, 16vw, 7rem); font-weight: 900; color: #fff; -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill; text-shadow: 5px 5px 0 var(--ink); pointer-events: none; }
  .count :global(span) { animation: zoom .8s ease-out both; }
  @keyframes zoom { from { transform: scale(2.2); opacity: 0; } 30% { transform: scale(1); opacity: 1; } }
  .commentary { background: #fff; border: 3px solid var(--ink); border-radius: var(--radius); box-shadow: 4px 4px 0 var(--ink); padding: .6rem .8rem; min-height: 8rem; }
  .comm-h { margin: 0 0 .3rem; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; font-size: .78rem; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; font-size: .9rem; line-height: 1.3; }
  .log :global(li) { animation: logpop .25s ease-out; }
  .log :global(li:nth-child(n + 2)) { opacity: .72; }
  .log :global(li:nth-child(n + 4)) { opacity: .45; }
  .log :global(.t) { font-variant-numeric: tabular-nums; font-weight: 800; opacity: .6; margin-right: .3em; font-size: .8em; }
  .log :global(.c0) { color: #1b8fae; font-weight: 800; }
  .log :global(.c1) { color: #c94a2c; font-weight: 800; }
  @keyframes logpop { from { transform: translateX(-8px); opacity: 0; } }

  .overlay { position: absolute; inset: 0; display: grid; place-items: center; padding: .8rem; background: rgba(43, 45, 66, .35); }
  .card { background: var(--paper); border: 3px solid var(--ink); border-radius: var(--radius); box-shadow: 6px 6px 0 var(--ink); padding: .9rem 1rem 1rem; width: min(440px, 100%); max-height: 100%; overflow: auto; text-align: center; animation: pop .3s cubic-bezier(.2, 1.4, .4, 1); }
  @keyframes pop { from { transform: scale(.85) rotate(-3deg); opacity: 0; } }
  .card p { margin: 0; }
  .kicker { font-weight: 900; text-transform: uppercase; letter-spacing: .12em; font-size: .78rem; color: #c2410c; }
  .vs { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .3rem; margin: .3rem 0 .4rem; }
  .vs-bot { display: grid; justify-items: center; gap: .15rem; min-width: 0; }
  .vs-bot canvas { width: 84px; height: 84px; }
  .vs-bot strong { font-size: .95rem; line-height: 1.15; overflow-wrap: anywhere; }
  .vs-v { font-weight: 900; font-size: 1.5rem; color: #fff; background: var(--ink); border-radius: 10px; padding: .1rem .45rem; transform: rotate(-6deg); }
  .intro-parts { list-style: none; margin: 0 0 .5rem; padding: 0; display: grid; gap: .2rem; font-size: .84rem; text-align: left; }
  .intro-parts :global(li) { display: grid; grid-template-columns: 1fr auto 1fr; gap: .4rem; align-items: center; }
  .intro-parts :global(li > span:last-child) { text-align: right; }
  .intro-parts :global(.k) { font-size: .7rem; font-weight: 900; text-transform: uppercase; letter-spacing: .06em; opacity: .6; text-align: center; }
  .intro-map { display: grid; grid-template-columns: 92px 1fr; gap: .7rem; align-items: center; text-align: left; margin-bottom: .7rem; }
  .intro-map canvas { width: 92px; height: 92px; border: 2px solid var(--ink); border-radius: 10px; }
  .intro-notes { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; font-size: .84rem; line-height: 1.3; }
  .intro-notes :global(b) { font-weight: 800; }
  .intro-notes :global(.good) { color: #1f8a4c; }
  .intro-notes :global(.bad) { color: #c0392b; }
  .end-title { font-size: clamp(1.6rem, 4.6vw, 2.2rem); font-weight: 900; line-height: 1.1; }
  .end-card[data-won='true'] .end-title { color: #1f8a4c; }
  .end-card[data-won='false'] .end-title { color: #c0392b; }
  .end-how { font-weight: 700; margin: .25rem 0 .2rem !important; line-height: 1.3; }
  .end-score { font-variant-numeric: tabular-nums; font-size: .9rem; opacity: .85; }
  .end-streak { font-weight: 900; font-size: 1.05rem; margin: .5rem 0 .5rem !important; }
  .end-streak :global(.new) { display: inline-block; background: var(--sun); border: 2px solid var(--ink); border-radius: 999px; padding: 0 .5rem; transform: rotate(-3deg); font-size: .85rem; margin-left: .3rem; }
  .end-buttons { display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; margin-top: .3rem; }

  @media (max-width: 860px) {
    .builder { grid-template-columns: minmax(0, 1fr); gap: .9rem; }
    .preview-card { position: static; grid-template-columns: 110px minmax(0, 1fr); align-items: center; gap: .45rem .8rem; padding: .7rem; }
    .preview { grid-row: span 3; }
    .fight-row, .best-line { grid-column: 1 / -1; }
    .stage-wrap { grid-template-columns: minmax(0, 1fr); gap: .7rem; }
    .commentary { min-height: 0; padding: .45rem .7rem; }
    .log :global(li:nth-child(n + 4)) { display: none; }
  }
  @media (max-width: 520px) {
    .part { padding: .4rem .5rem .55rem; }
    .opts { gap: .3rem; }
    .opt { padding: .25rem .1rem .35rem; border-radius: 12px; }
    .opt-icon { width: 52px; height: 52px; }
    .opt-name { font-size: .74rem; }
    .opt-hint { font-size: .8rem; }
    .hud { gap: .35rem; grid-template-columns: 1fr auto 1fr; }
    .side { padding: .25rem .4rem .35rem; border-width: 2px; box-shadow: 2px 2px 0 var(--ink); }
    .side-name { font-size: .78rem; }
    .side-top { flex-wrap: wrap; }
    .side-dealt { font-size: .7rem; }
    .timer { font-size: 1.2rem; }
    .spd { font-size: .75rem; padding: .1rem .45rem; min-height: 30px; }
    .card { padding: .65rem .7rem .75rem; }
    .vs-bot canvas { width: 64px; height: 64px; }
    .intro-map { grid-template-columns: 72px 1fr; }
    .intro-map canvas { width: 72px; height: 72px; }
    .intro-notes, .intro-parts { font-size: .78rem; }
    .btn--big { font-size: 1.05rem; }
    .stage { border-width: 2px; box-shadow: 4px 4px 0 var(--ink); }
  }
</style>
