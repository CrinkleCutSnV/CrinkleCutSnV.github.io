---
// Tea Dunk. All logic lives in src/scripts/tea-dunk/.
---
<div class="tdk" data-tea-dunk data-phase="intro">
  <canvas aria-label="Tea Dunk. A mug of tea on the table. Press and hold to dunk the biscuit, let go to lift it out."></canvas>

  <div class="hud">
    <div class="pill pill--who" data-who title="This round’s dunker and their signature biscuit">
      <span data-who-name>Up next…</span><span class="biccie-name" data-who-biscuit></span>
    </div>
    <div class="hud-right">
      <div class="pill pill--round" data-round>Biscuit 1 of 3</div>
      <div class="pill pill--live" data-live data-warn="">Score: 0</div>
      <div class="pill pill--best" data-best>Best: –</div>
    </div>
  </div>

  <div class="bubble is-hidden" data-bubble aria-live="polite"></div>

  <div class="hint is-hidden" data-hint>
    <strong data-hint-main>Press and hold to dunk</strong>
    <span data-hint-sub>Let go to lift the biscuit out. Don’t leave it too long!</span>
  </div>

  <div class="intro is-hidden" data-intro role="dialog" aria-live="polite" aria-label="Up next">
    <div class="intro-card">
      <p class="intro-kicker">Up next</p>
      <div class="intro-art">
        <canvas class="intro-face" data-intro-face width="96" height="96" aria-hidden="true"></canvas>
        <canvas class="intro-biscuit" data-intro-biscuit width="64" height="64" aria-hidden="true"></canvas>
      </div>
      <div class="intro-text">
        <h2 data-intro-name></h2>
        <p class="intro-tag" data-intro-tag></p>
        <p class="intro-quirk" data-intro-quirk></p>
      </div>
      <p class="intro-pour"><span data-intro-status>The kettle’s just boiled…</span> <button type="button" class="btn btn--small intro-go" data-intro-go>Ready! 🍵</button></p>
    </div>
  </div>

  <div class="end is-hidden" data-end role="dialog" aria-live="polite" aria-label="Result">
    <div class="end-card">
      <p class="end-rating" data-end-rating></p>
      <p class="end-mm" data-end-score></p>
      <p class="end-where" data-end-where></p>
      <p class="end-remark" data-end-remark></p>
      <div data-end-medal></div>
      <div class="end-breakdown" data-end-breakdown></div>
      <p><span class="end-best" data-end-best></span></p>
      <div class="end-buttons">
        <button type="button" class="btn" data-again>Next biscuit 🍪</button>
      </div>
    </div>
  </div>
</div>

<section class="regulars" aria-labelledby="dunkers-h">
  <h2 id="dunkers-h">Meet the dunkers</h2>
  <p>The same regulars from Split the G, each with a signature biscuit that suits them. The table picks who’s dunking each round, at random (never the same one twice in a game). Learn how long each biscuit can take.</p>
  <ul class="lineup" data-lineup></ul>
</section>

<script>
  import { initTeaDunk } from '../scripts/tea-dunk/game';
  document.querySelectorAll<HTMLElement>('[data-tea-dunk]').forEach((el) => initTeaDunk(el));
</script>

<style>
  .tdk {
    position: relative;
    width: 100%;
    height: clamp(520px, min(80vh, 70vw), 780px);
    border: 3px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--ink);
    background: #e7dfcf;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: pointer; }
  .tdk[data-phase='playing'] canvas { cursor: grabbing; }
  .tdk[data-phase='dunk-result'] canvas, .tdk[data-phase='gameover'] canvas { cursor: default; }
  .hud { position: absolute; inset: .7rem .7rem auto; display: flex; justify-content: space-between; align-items: flex-start; gap: .5rem; pointer-events: none; }
  .hud-right { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4rem; }
  .pill { background: #fff; border: 2px solid var(--ink); border-radius: 999px; padding: .3rem .85rem; font: inherit; font-weight: 800; font-size: clamp(.8rem, 2vw, 1.05rem); box-shadow: 3px 3px 0 var(--ink); color: var(--ink); }
  .pill--who { display: inline-flex; gap: .45rem; align-items: center; max-width: 70%; text-align: left; }
  .biccie-name { font-size: .8em; letter-spacing: .02em; white-space: nowrap; opacity: .8; }
  .pill--best { background: var(--sun); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pill--live { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pill--live[data-warn='crumbs'], .pill--live[data-warn='sag'] { background: #fff4d6; }
  .pill--live[data-warn='crack'] { background: #ffe0b0; }
  .pill--live[data-warn='critical'] { background: #ffd0d0; animation: pulse .45s ease-in-out infinite alternate; }
  @keyframes pulse { from { transform: none; } to { transform: scale(1.04); } }

  .bubble { position: absolute; transform: translate(-6%, -100%); max-width: min(300px, 46%); background: #fff; border: 3px solid var(--ink); border-radius: 18px; padding: .55rem .8rem; font-weight: 800; line-height: 1.3; font-size: clamp(.85rem, 1.9vw, 1.05rem); box-shadow: 3px 3px 0 var(--ink); pointer-events: none; animation: pop .25s ease-out; }
  .bubble::after { content: ''; position: absolute; left: 14px; bottom: -14px; width: 18px; height: 14px; background: #fff; border: 3px solid var(--ink); border-top: 0; border-right: 0; clip-path: polygon(0 0, 100% 0, 0 100%); transform: skewX(20deg); }

  .hint { position: absolute; left: 50%; bottom: 4%; transform: translateX(-50%); background: rgba(255,255,255,.95); border: 2px solid var(--ink); border-radius: 14px; padding: .55rem .95rem; text-align: center; pointer-events: none; display: grid; gap: .15rem; box-shadow: 3px 3px 0 var(--ink); animation: bob 2.2s ease-in-out infinite; white-space: nowrap; }
  .hint strong { font-size: 1.05rem; }
  .hint span { font-size: .85rem; opacity: .8; }
  @keyframes bob { 50% { transform: translate(-50%, -5px); } }

  .intro { position: absolute; left: 0; right: 0; top: 3.6rem; display: flex; justify-content: center; padding: 0 .8rem; pointer-events: none; }
  .intro-card { pointer-events: auto; display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'kick kick' 'art text' 'pour pour'; gap: .3rem .9rem; align-items: center; background: #fffaf0; border: 3px solid var(--ink); border-radius: var(--radius); box-shadow: 6px 6px 0 var(--ink); padding: .8rem 1rem .9rem; width: min(540px, 100%); animation: slidein .35s cubic-bezier(.2,1.4,.4,1); }
  .intro-kicker { grid-area: kick; margin: 0; font-weight: 900; text-transform: uppercase; letter-spacing: .12em; font-size: .78rem; color: #c2410c; }
  .intro-art { grid-area: art; display: grid; justify-items: center; gap: .3rem; }
  .intro-face { width: 96px; height: 96px; border-radius: 14px; background: radial-gradient(circle at 50% 35%, #f3efe4, #d9ceb8); }
  .intro-biscuit { width: 64px; height: 64px; border-radius: 12px; border: 2px solid var(--ink); background: #fff; }
  .intro-text { grid-area: text; }
  .intro-text h2 { margin: 0; font-size: clamp(1.2rem, 2.6vw, 1.5rem); line-height: 1.15; }
  .intro-tag { margin: .2rem 0 .3rem; font-size: .9rem; opacity: .85; line-height: 1.3; }
  .intro-quirk { margin: 0; font-size: .85rem; font-weight: 700; line-height: 1.3; }
  .intro-quirk :global(b) { color: #c2410c; }
  .intro-pour { grid-area: pour; margin: .2rem 0 0; display: flex; justify-content: space-between; align-items: center; gap: .6rem; font-weight: 700; opacity: .9; }
  .btn--small { font-size: .9rem; padding: .3rem .9rem; }
  .intro-go { font-size: 1rem; min-height: 44px; padding: .45rem 1.1rem; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .intro-go:global(.is-nudged) { animation: nudge .45s ease; }
  @keyframes nudge { 0%, 100% { transform: none; } 20% { transform: translateX(-5px) rotate(-3deg); } 45% { transform: translateX(5px) rotate(3deg); } 70% { transform: translateX(-3px); } }
  @keyframes slidein { from { transform: translateY(-14px) scale(.96); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (min-width: 701px) {
    .intro { justify-content: flex-end; padding: 0 1rem; }
    .intro-card { width: min(320px, 34%); grid-template-columns: 1fr; grid-template-areas: 'kick' 'art' 'text' 'pour'; justify-items: start; }
    .intro-art { display: flex; align-items: center; gap: .5rem; }
    .intro-pour { flex-wrap: wrap; width: 100%; }
  }
  .regulars { margin-top: 1.6rem; }
  .regulars h2 { margin: 0 0 .2rem; }
  .regulars > p { margin: 0 0 .8rem; opacity: .85; max-width: 70ch; }
  .lineup { list-style: none; margin: 0 0 .9rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .6rem; }
  .lineup :global(li) { display: grid; grid-template-columns: 72px 48px 1fr; grid-template-rows: auto auto auto; gap: .15rem .55rem; align-items: center; text-align: left; background: #fff; border: 2px solid var(--ink); border-radius: 14px; padding: .45rem .6rem; box-shadow: 3px 3px 0 var(--ink); }
  .lineup :global(canvas.face) { width: 72px; height: 72px; grid-row: span 3; border-radius: 12px; background: radial-gradient(circle at 50% 35%, #f3efe4, #d9ceb8); touch-action: auto; }
  .lineup :global(canvas.biccie) { width: 48px; height: 48px; grid-row: 1 / span 2; border-radius: 10px; border: 2px solid var(--ink); background: #fff; touch-action: auto; }
  .lineup :global(strong) { font-size: 1rem; grid-column: 3; }
  .lineup :global(.tag) { font-size: .82rem; line-height: 1.3; opacity: .85; grid-column: 3; }
  .lineup :global(.quirk) { font-size: .78rem; font-weight: 700; line-height: 1.3; grid-column: 2 / -1; }
  .lineup :global(.diffdots) { white-space: nowrap; letter-spacing: .05em; color: var(--ink); }
  .lineup :global(.quirk b) { color: #c2410c; }
  .btn { font: inherit; font-weight: 800; font-size: 1rem; background: var(--accent); color: #fff; border: 3px solid var(--ink); border-radius: 999px; padding: .5rem 1.2rem; box-shadow: 3px 3px 0 var(--ink); cursor: pointer; }
  .btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink); }
  .btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
  .btn--ghost { background: #fff; color: var(--ink); }

  .end { position: absolute; top: 0; bottom: 0; right: 0; width: 38%; display: grid; place-items: center; padding: 3.4rem 1rem 1rem; pointer-events: none; }
  .end-card { pointer-events: auto; background: #fff; border: 3px solid var(--ink); border-radius: var(--radius); box-shadow: 6px 6px 0 var(--ink); padding: 1rem 1.2rem 1.2rem; text-align: center; width: 100%; max-width: 380px; animation: pop .25s ease-out; }
  @keyframes pop { from { transform: scale(.85) rotate(-3deg); opacity: 0; } }
  .end-card p { margin: 0; }
  .end-rating { font-size: clamp(1.4rem, 3.4vw, 2rem); font-weight: 900; line-height: 1.1; }
  .end-card[data-band='great'] .end-rating { color: #1f8a4c; }
  .end-card[data-band='miss'] .end-rating { color: #c0392b; }
  .end-mm { font-size: clamp(2.2rem, 6vw, 3.2rem); font-weight: 900; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .end-where { font-weight: 800; font-size: .9rem; opacity: .7; }
  .end-remark { margin: .4rem 0 .6rem !important; line-height: 1.35; }
  .end-best { display: inline-block; font-weight: 800; margin-bottom: .8rem; padding: .1rem .7rem; border: 2px solid transparent; }
  .end-best.is-new { background: var(--sun); border: 2px solid var(--ink); border-radius: 999px; transform: rotate(-3deg); }
  .end-buttons { display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; }
  .end-breakdown :global(ul) { list-style: none; margin: .2rem 0 .6rem; padding: 0; text-align: left; }
  .end-breakdown :global(li) { display: flex; justify-content: space-between; align-items: baseline; gap: .7rem; font-size: .85rem; padding: .28rem 0; border-top: 1px solid rgba(43,45,66,.1); }
  .end-breakdown :global(.who) { display: grid; min-width: 0; line-height: 1.25; }
  .end-breakdown :global(.who small) { font-size: .78rem; opacity: .7; }
  .end-breakdown :global(li b) { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .end-breakdown :global(li.is-miss b) { color: #c0392b; }

  @media (max-width: 700px) {
    .tdk { height: clamp(560px, 82svh, 760px); }
    .end { width: auto; left: 0; top: auto; padding: .5rem; }
    .end-card { max-width: none; padding: .6rem .8rem .75rem; display: grid; grid-template-columns: auto 1fr; gap: 0 .7rem; text-align: left; align-items: center; }
    .end-rating { grid-column: 1 / -1; font-size: 1.3rem; text-align: center; }
    .end-mm { font-size: 1.9rem; grid-row: span 2; }
    .end-where { font-size: .8rem; }
    .end-remark { font-size: .82rem; margin: 0 !important; }
    .end-card > div[data-end-medal], .end-card > div[data-end-breakdown], .end-card > p:has(.end-best), .end-buttons { grid-column: 1 / -1; }
    .end-card > div[data-end-medal] { margin-top: .4rem; }
    .end-best { margin-bottom: .4rem; font-size: .85rem; }
    .end-card > p:has(.end-best) { text-align: center; }
    .end-buttons { flex-wrap: nowrap; gap: .4rem; }
    .end-buttons .btn { font-size: .84rem; padding: .38rem .75rem; white-space: nowrap; flex: 1; }
    .end-card :global(.medal-pop) { margin: 0 auto .3rem; }
    .bubble { max-width: 56%; font-size: .82rem; padding: .4rem .6rem; }
    .lineup { grid-template-columns: 1fr; gap: .45rem; }
    .lineup :global(li) { grid-template-columns: 56px 40px 1fr; padding: .35rem .5rem; }
    .lineup :global(canvas.face) { width: 56px; height: 56px; }
    .lineup :global(canvas.biccie) { width: 40px; height: 40px; }
    .lineup :global(.quirk) { font-size: .74rem; }
    .intro { top: 3.2rem; }
    .tdk[data-upnext='open'] .pill--who { visibility: hidden; }
    .intro-card { grid-template-columns: auto 1fr; padding: .6rem .7rem .7rem; gap: .2rem .6rem; }
    .intro-face { width: 64px; height: 64px; }
    .intro-biscuit { width: 48px; height: 48px; }
    .intro-tag { font-size: .86rem; }
    .intro-quirk { font-size: .84rem; }
    .intro-pour { flex-wrap: wrap; }
    .intro-go { flex: 1 1 100%; min-height: 48px; font-size: 1.05rem; }
    .hint { bottom: 2.5%; white-space: normal; max-width: 92%; }
    .hud { flex-wrap: wrap; }
    .pill--who { max-width: 100%; }
  }
  .is-hidden { display: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .hint, .pill--live[data-warn='critical'] { animation: none; }
  }
</style>
